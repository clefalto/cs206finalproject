        {
            "name": "feature_flag_rollout",
            "parameters": [
                "user_id"
            ],
            "branches": [
                [
                    {
                        "type": "if",
                        "condition": "not (0 <= percentage <= 1)",
                        "branches": null,
                        "body_contains": "raise ValueError(\"percentage must be in [0, 1]\")",
                        "returns": null,
                        "early_exit": true
                    },
                    {
                        "type": "else",
