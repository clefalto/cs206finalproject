    "functions": [
        {
            "name": "storage_mix",
            "parameters": [
                "current",
                "target"
            ],
            "branches": [
                [
                    {
                        "type": "if",
                        "condition": "len(current) != len(target)",
                        "branches": null,
                        "body_contains": "raise ValueError(\"shape mismatch\")",
                        "returns": null,
                        "early_exit": true
                    },
                    {
                        "type": "else",
                        "condition": "not (len(current) != len(target))",
                        "body_contains": "if not current:\n        raise ValueError(\"empty allocation\")\nadjusted = [c + (t - c) * damping for c, t in zip(current, target)]\n# BUG: does not renormalize to sum to 1.0.\nreturn adjusted",
                        "returns": "adjusted",
                        "early_exit": false
                    }
                ],
                [
                    {
                        "type": "if",
                        "condition": "not current",
                        "branches": null,
                        "body_contains": "raise ValueError(\"empty allocation\")",
                        "returns": null,
                        "early_exit": true
                    },
                    {
                        "type": "else",
                        "condition": "not (not current)",
                        "body_contains": "adjusted = [c + (t - c) * damping for c, t in zip(current, target)]\n# BUG: does not renormalize to sum to 1.0.\nreturn adjusted",
                        "returns": "adjusted",
                        "early_exit": false
                    }
                ]
            ],
            "returns": "adjusted"
        }
    ]
