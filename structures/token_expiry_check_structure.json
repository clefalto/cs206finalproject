    "functions": [
        {
            "name": "token_expiry_check",
            "parameters": [
                "tokens",
                "key",
                "now"
            ],
            "branches": [
                [
                    {
                        "type": "if",
                        "condition": "record is None",
                        "branches": null,
                        "body_contains": "return None",
                        "returns": "None",
                        "early_exit": true
                    },
                    {
                        "type": "else",
                        "condition": "not (record is None)",
                        "body_contains": "value, expires_at = record\n# BUG: uses strict > so token valid at exact expiry time.\nif now > expires_at:\n        return None\nreturn value",
                        "returns": "value",
