                        "condition": "len(current) != len(target)",
                        "branches": null,
                        "body_contains": "raise ValueError(\"shape mismatch\")",
                        "returns": null,
                        "early_exit": true
                    },
                    {
                        "type": "else",
                        "condition": "not (len(current) != len(target))",
                        "body_contains": "if not current:\n        raise ValueError(\"empty weights\")\nupdated = [c + (t - c) * damping for c, t in zip(current, target)]\n# BUG: missing normalization to sum to 1.0.\nreturn updated",
                        "returns": "updated",
                        "early_exit": false
                    }
                ],
                [
                    {
                        "type": "if",
                        "condition": "not current",
                        "branches": null,
                        "body_contains": "raise ValueError(\"empty weights\")",
                        "returns": null,
                        "early_exit": true
                    },
                    {
                        "type": "else",
                        "condition": "not (not current)",
                        "body_contains": "updated = [c + (t - c) * damping for c, t in zip(current, target)]\n# BUG: missing normalization to sum to 1.0.\nreturn updated",
                        "returns": "updated",
